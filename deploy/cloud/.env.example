QUIRE_HUB_VERSION=latest
QUIRE_HUB_QUOTA_MB=1024
QUIRE_HUB_MAX_SESSIONS=256
RELAY_HOSTNAME=relay.example.org
# S3-compatible object storage for backups (Cloudflare R2, Backblaze B2, Hetzner Object Storage).
BACKUP_PROVIDER=Cloudflare
BACKUP_ENDPOINT=https://<account>.r2.cloudflarestorage.com
BACKUP_BUCKET=quire-hub-backup
BACKUP_FORCE_PATH_STYLE=false
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
