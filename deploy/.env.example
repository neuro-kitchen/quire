# Copy to .env next to docker-compose.yml to change these.
# The image: the published one, or one you built (QUIRE_HUB_IMAGE=localhost/quire-hub, QUIRE_HUB_VERSION=local).
QUIRE_HUB_IMAGE=ghcr.io/neuro-kitchen/quire-hub
QUIRE_HUB_VERSION=latest
# Storage limit per person in megabytes (0: none).
QUIRE_HUB_QUOTA_MB=0
# Your own iroh relay (empty: the public relays).
QUIRE_HUB_RELAY=
QUIRE_HUB_MAX_SESSIONS=64
RUST_LOG=quire_hub=info,warn
