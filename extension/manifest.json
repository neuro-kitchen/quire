{
  "manifest_version": 3,
  "name": "quire",
  "version": "0.1.0",
  "description": "Save the paper you are viewing (page or PDF) to your local quire library.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_title": "Save to quire" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "browser_specific_settings": {
    "gecko": {
      "id": "quire@neuro-kitchen",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
