/target
**/*.rs.bk

# Data and outputs never in git
/data/
/library/
.data
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.pdf
!crates/**/tests/fixtures/*.pdf

# Secrets and local settings: environment files, keys, quire's server token and config
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
serve-token
config.toml.bak
.netrc
.pypirc

# Python
.venv/
__pycache__/
*.py[oc]
*.so
.pytest_cache/

# Notes, task plans and editors
.knowledge
.tasks
.idea/
.vscode/
*.swp
.DS_Store

# mdBook output (docs/)
/docs/book/
